# -*- coding: utf-8 -*-
"""
Fledge North plugin: Push PV/BESS and EV charger readings to FlexMeasures

- Reads Fledge assets periodically
- Maps asset + key → FlexMeasures sensor IDs
- Pushes each reading to the corresponding sensor endpoint
- Handles retries and logs errors
"""

import requests
import json
import time
from datetime import datetime, timezone

__author__ = "ChatGPT"
__version__ = "1.0"

# -------------------------
# Configuration defaults
# -------------------------
_DEFAULT_CONFIG = {
    "plugin": {
        "description": "Fledge North plugin to push readings to FlexMeasures",
        "type": "string",
        "default": "flex"
    },
    "pollInterval": {
        "description": "Polling interval in seconds",
        "type": "integer",
        "default": "10"
    },
    "flexMeasuresUrl": {
        "description": "Base URL of FlexMeasures API",
        "type": "string",
        "default": "http://flexmeasures.example.com/api"
    },
    "apiToken": {
        "description": "FlexMeasures API token",
        "type": "string",
        "default": ""
    }
}

# -------------------------
# Map Fledge asset/key → FlexMeasures sensor_id
# -------------------------
SENSOR_MAP = {
    ("PV_BESS", "power_kw"): 4,
    ("PV_BESS", "SoC_percent"): 5,
    ("PV_System", "power_kw"): 3,
    ("CP001", "power_kw"): 1,
    ("CP001", "soc"): 14,
    ("CP002", "power_kw"): 15,
    ("CP002", "soc"): 16
}

UNIT_MAP = {
    "power_kw": "kW",
    "SoC_percent": "%",
    "soc": "%"
}

# -------------------------
# Fledge North plugin hooks
# -------------------------
def plugin_info():
    return {
        "name": "flex",
        "version": "1.0",
        "mode": "poll",
        "type": "north",
        "interface": "1.0",
        "config": _DEFAULT_CONFIG
    }

def plugin_init(config):
    handle = {
        "poll_interval": int(config["pollInterval"]["value"]),
        "flex_url": config["flexMeasuresUrl"]["value"].rstrip("/"),
        "api_token": config["apiToken"]["value"]
    }
    return handle

# -------------------------
# Helper functions
# -------------------------
def utc_now_iso():
    return datetime.utcnow().replace(tzinfo=timezone.utc).isoformat()

def push_reading(sensor_id, value, unit, flex_url, api_token):
    url = f"{flex_url}/sensors/{sensor_id}/data"
    payload = {
        "value": value,
        "unit": unit,
        "timestamp": utc_now_iso()
    }
    headers = {
        "Authorization": f"Bearer {api_token}",
        "Content-Type": "application/json"
    }

    for attempt in range(3):  # retry up to 3 times
        try:
            r = requests.post(url, json=payload, headers=headers, timeout=5)
            if r.status_code in (200, 201):
                return True
            else:
                print(f"[FlexMeasures North] Failed to push sensor {sensor_id}: {r.status_code} {r.text}")
        except Exception as e:
            print(f"[FlexMeasures North] Exception pushing sensor {sensor_id}: {e}")
        time.sleep(1)
    return False

def process_asset(asset_name, readings, handle):
    flex_url = handle["flex_url"]
    api_token = handle["api_token"]
    for key, value in readings.items():
        sensor_id = SENSOR_MAP.get((asset_name, key))
        if sensor_id:
            unit = UNIT_MAP.get(key, "")
            push_reading(sensor_id, value, unit, flex_url, api_token)

# -------------------------
# Polling hook
# -------------------------
def plugin_poll(handle):
    """
    Called every pollInterval seconds.
    Retrieves all assets from Fledge and pushes readings to FlexMeasures.
    """
    try:
        # Pull all assets from Fledge
        r = requests.get("http://localhost:8081/fledge/asset", timeout=5)
        if r.status_code != 200:
            print(f"[FlexMeasures North] Failed to fetch assets: {r.status_code}")
            return

        assets = r.json()
        for asset in assets:
            asset_name = asset["assetCode"]
            readings = asset.get("reading", {})
            if readings:
                process_asset(asset_name, radings, handle)

    except Exception as e:
        print(f"[FlexMeasures North] Exception in plugin_poll: {e}")

    return None  # no readings to return, pushing only

# -------------------------
# Reconfigure & shutdown
# -------------------------
def plugin_reconfigure(handle, new_config):
    handle["poll_interval"] = int(new_config["pollInterval"]["value"])
    handle["flex_url"] = new_config["flexMeasuresUrl"]["value"].rstrip("/")
    handle["api_token"] = new_config["apiToken"]["value"]
    return handle

def plugin_shutdown(handle):
    passe
